---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LANG } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Narrow reading measure — for articles, poems and recipes. */
  narrow?: boolean;
}

const { narrow = false, ...head } = Astro.props;
---

<!doctype html>
<html lang={LANG}>
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <a class="skip-link" href="#main">Naar hoofdinhoud</a>
    <SiteHeader />
    <main id="main" class:list={['container', narrow && 'container--narrow']}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
