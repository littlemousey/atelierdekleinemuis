---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

// Compare with trailing slashes stripped, so the match is independent of the
// site's trailingSlash setting.
const strip = (p: string) => p.replace(/\/+$/, '') || '/';
const path = strip(Astro.url.pathname);

// Highlight exactly one link: the longest href that matches the current path.
const active = [...NAV_LINKS]
  .filter((l) => {
    const href = strip(l.href);
    return path === href || (href !== '/' && path.startsWith(`${href}/`));
  })
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="nav-brand" href="/">{SITE_TITLE}</a>
    <nav class="site-nav" aria-label="Hoofdnavigatie">
      <ul>
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={link.href === active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
