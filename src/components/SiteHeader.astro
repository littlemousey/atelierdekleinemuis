---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

// Compare with trailing slashes stripped, so the match is independent of the
// site's trailingSlash setting.
const strip = (p: string) => p.replace(/\/+$/, '') || '/';
const path = strip(Astro.url.pathname);

// Highlight exactly one link: the longest href that matches the current path.
const active = [...NAV_LINKS]
  .filter((l) => {
    const href = strip(l.href);
    return path === href || (href !== '/' && path.startsWith(`${href}/`));
  })
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="nav-brand" href="/">{SITE_TITLE}</a>
    <nav class="site-nav" aria-label="Hoofdnavigatie">
      <ul>
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.href === active ? 'page' : undefined}
              aria-label={'icon' in link ? link.label : undefined}
              title={'icon' in link ? link.label : undefined}
            >
              {'icon' in link ? (
                /* Lucide `home` — the Dutch word for it reads oddly in a nav bar. */
                <svg
                  class="nav-icon"
                  viewBox="0 0 24 24" width="13" height="13"
                  fill="none" stroke="currentColor" stroke-width="2.25"
                  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                >
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
              ) : (
                link.label
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
