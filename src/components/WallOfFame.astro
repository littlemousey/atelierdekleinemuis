---
import { MICE } from '../data/mice';
---

<ul class="wall">
  {MICE.map((mouse) => (
    <li>
      <button
        type="button"
        class="wall__btn"
        data-collage={mouse.collageImgUrl}
        data-name={mouse.name}
        aria-haspopup="dialog"
      >
        <img
          class="wall__avatar"
          src={mouse.imgUrl}
          alt={`Muis ${mouse.name}`}
          width="144"
          height="144"
          loading="lazy"
          decoding="async"
        />
        <span class="wall__name">{mouse.name}</span>
        {mouse.exLab && <span class="wall__badge">ex-labmuis</span>}
        <span class="wall__traits">{mouse.traits}</span>
      </button>
    </li>
  ))}
</ul>

<dialog class="collage-dialog" id="collage-dialog" aria-label="Foto's van de muis">
  <div class="collage-dialog__bar">
    <strong id="collage-dialog-title"></strong>
    <button type="button" class="collage-dialog__close" data-close>Sluiten</button>
  </div>
  <img id="collage-dialog-img" src="" alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#collage-dialog');
  const img = document.querySelector<HTMLImageElement>('#collage-dialog-img');
  const label = document.querySelector<HTMLElement>('#collage-dialog-title');

  if (dialog && img && label) {
    document.querySelectorAll<HTMLButtonElement>('.wall__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.name ?? '';
        img.src = btn.dataset.collage ?? '';
        img.alt = `Collage van muis ${name}`;
        label.textContent = name;
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());

    // Click on the backdrop (outside the dialog box) closes it too.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
