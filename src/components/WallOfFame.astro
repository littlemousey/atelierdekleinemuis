---
import { Image } from 'astro:assets';
import { MICE_BY_ERA } from '../data/mice';
import { shortDate } from '../lib/period';
---

{MICE_BY_ERA.map(({ era, mice }) => (
  <section class="era">
    <div class="era__head">
      <h2 id={era.id}>{era.label}</h2>
      <span class="era__count">{mice.length}</span>
    </div>
    <p class="era__note">{era.note}</p>

    <ul class="wall">
      {mice.map((mouse) => (
        <li>
          <a class="polaroid" href={`/wall-of-fame/${mouse.id}/`}>
            <Image
              class="plate"
              src={mouse.img}
              alt=""
              width={320}
              densities={[1, 2]}
              format="webp"
              loading="lazy"
            />
            <span class="polaroid__name">{mouse.name}</span>
            {mouse.exLab && <span class="polaroid__lab">ex-labmuis</span>}
            <span class="polaroid__period">{shortDate(mouse.from)} – {shortDate(mouse.to)}</span>
            {mouse.epithet && <span class="polaroid__epithet">{mouse.epithet}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
))}
