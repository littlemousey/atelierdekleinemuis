---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { AUTHOR } from '../../../consts';

export async function getStaticPaths() {
  const items = (await getCollection('gedichten')).sort((a, b) => a.data.order - b.data.order);
  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: items[i - 1] ?? null, next: items[i + 1] ?? null },
  }));
}

interface Props {
  entry: CollectionEntry<'gedichten'>;
  prev: CollectionEntry<'gedichten'> | null;
  next: CollectionEntry<'gedichten'> | null;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Poem',
  name: entry.data.title,
  description: entry.data.description,
  inLanguage: 'nl-NL',
  datePublished: entry.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: AUTHOR },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/atelier/gedichten/${entry.id}/`, Astro.site).href,
  },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.pubDate}
  jsonLd={jsonLd}
  narrow
>
  <article class="prose poem">
    <p class="kicker">Gedicht</p>
    <h1>{entry.data.title}</h1>
    <Content />

    <nav class="article__nav" aria-label="Meer gedichten">
      {prev ? <a href={`/atelier/gedichten/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`/atelier/gedichten/${next.id}/`}>{next.data.title} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>
