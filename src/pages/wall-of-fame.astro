---
import BaseLayout from '../layouts/BaseLayout.astro';
import WallOfFame from '../components/WallOfFame.astro';
import { MICE, ERAS } from '../data/mice';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Wall of fame — de muizen van Atelier de kleine muis',
  inLanguage: 'nl-NL',
  numberOfItems: MICE.length,
};
---

<BaseLayout
  title="Wall of fame"
  description={`Alle ${MICE.length} muizen van Atelier de kleine muis, gegroepeerd per tijdperk — van de rocksterren tot de Adventure Time-prinsessen.`}
  jsonLd={jsonLd}
>
  <div class="page-head">
    <p class="kicker">{MICE.length} muizen · {ERAS.length} tijdperken</p>
    <h1>Wall of fame</h1>
    <p class="lede">
      Alle muizen die hier gewoond hebben, gegroepeerd per tijdperk — elk nest kreeg zijn eigen
      naamthema. De muizen met het label <em>ex-labmuis</em> zijn geadopteerd uit een laboratorium.
      Klik op een muis om meer foto's te zien.
    </p>
  </div>

  <WallOfFame />
</BaseLayout>
