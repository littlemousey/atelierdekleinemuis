---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const verhalen = (await getCollection('verhalen')).sort((a, b) => a.data.order - b.data.order);

  return verhalen.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: verhalen[index - 1] ?? null,
      next: verhalen[index + 1] ?? null,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'verhalen'>;
  prev: CollectionEntry<'verhalen'> | null;
  next: CollectionEntry<'verhalen'> | null;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const url = new URL(`/verhalen/${entry.id}`, Astro.site).href;
const isRecipe = entry.data.type === 'recept';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isRecipe ? 'Recipe' : 'Article',
  headline: entry.data.title,
  name: entry.data.title,
  description: entry.data.description,
  inLanguage: 'nl-NL',
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: AUTHOR },
  publisher: { '@type': 'Organization', name: SITE_TITLE },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@type': 'Book', name: SITE_TITLE, url: new URL('/verhalen', Astro.site).href },
};

const dateFmt = new Intl.DateTimeFormat('nl-NL', { dateStyle: 'long' });
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.pubDate}
  modifiedTime={entry.data.updatedDate}
  jsonLd={jsonLd}
>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <p class="article__meta">
      {isRecipe ? 'Recept' : 'Verhaal'} van {AUTHOR} ·
      <time datetime={entry.data.pubDate.toISOString()}>
        {dateFmt.format(entry.data.pubDate)}
      </time>
      {entry.data.updatedDate && (
        <> · bijgewerkt <time datetime={entry.data.updatedDate.toISOString()}>
          {dateFmt.format(entry.data.updatedDate)}
        </time></>
      )}
    </p>

    <Content />

    <nav class="article__nav" aria-label="Meer verhalen">
      {prev ? <a href={`/verhalen/${prev.id}`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`/verhalen/${next.id}`}>{next.data.title} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>
