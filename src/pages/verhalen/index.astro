---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/Plate.astro';
import { AUTHOR, SITE_TITLE } from '../../consts';

const verhalen = (await getCollection('verhalen')).sort((a, b) => a.data.order - b.data.order);

const voorwoord = await getEntry('paginas', 'voorwoord');
const nawoord = await getEntry('paginas', 'nawoord');

// De inleiding op deze pagina is de eerste alinea van het voorwoord zelf, zodat
// die tekst maar op één plek geschreven wordt. Het is kale prosa zonder inline
// markdown, dus hij kan als tekst gezet worden.
const opening = voorwoord!.body?.trimStart().split(/\n\s*\n/)[0] ?? '';

// De inhoudsopgave is het boek in leesvolgorde: het voorwoord opent, het
// nawoord sluit, de verhalen staan ertussen.
const inhoud = [
  { href: '/verhalen/voorwoord/', ...voorwoord!.data },
  ...verhalen.map((v) => ({ href: `/verhalen/${v.id}/`, ...v.data })),
  { href: '/verhalen/nawoord/', ...nawoord!.data },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: SITE_TITLE,
  author: { '@type': 'Person', name: AUTHOR },
  inLanguage: 'nl-NL',
  url: new URL('/verhalen/', Astro.site).href,
  hasPart: inhoud.map((deel) => ({
    '@type': 'CreativeWork',
    name: deel.title,
    url: new URL(deel.href, Astro.site).href,
  })),
};
---

<BaseLayout
  title="Verhalen van de muis"
  description="De inhoudsopgave van Atelier de kleine muis: korte verhalen over muizen, mollen en koolmezen, geschreven door A.N.S. de Nijs."
  jsonLd={jsonLd}
>
  <div class="page-head">
    <p class="kicker">Een levend boek</p>
    <h1>Verhalen van de muis</h1>
  </div>

  <div class="prose">
    <p>{opening}</p>
    <p class="verder"><a href="/verhalen/voorwoord/">Lees verder in het voorwoord →</a></p>

    <Plate
      src="/img/slapende-muizen.jpg"
      alt="Slapende muizen dicht tegen elkaar aan"
      width="900"
      height="600"
    />
  </div>

  <hr class="hr" />

  <h2>Inhoudsopgave</h2>
  <ul class="index-list index-list--stacked">
    {inhoud.map((deel) => (
      <li>
        <a href={deel.href}>
          <span class="index-list__title">{deel.title}</span>
          <span class="index-list__note">{deel.description}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
