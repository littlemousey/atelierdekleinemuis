---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WallOfFame from '../../components/WallOfFame.astro';
import { MICE } from '../../data/mice';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Wall of fame — de muizen van Atelier de kleine muis',
  inLanguage: 'nl-NL',
  numberOfItems: MICE.length,
};
---

<BaseLayout
  title="Wall of fame"
  description={`De ${MICE.length} muizen van Atelier de kleine muis, van ex-labmuis Haley tot Sabrina. Klik op een muis voor meer foto's.`}
  jsonLd={jsonLd}
>
  <div class="prose">
    <h1>Wall of fame</h1>
    <p>
      Alle muizen die hier gewoond hebben, met hun eigen karakter. De muizen met het label
      <em>ex-labmuis</em> zijn geadopteerd uit een laboratorium. Klik op een muis om meer foto's te
      zien.
    </p>
  </div>

  <WallOfFame />
</BaseLayout>
