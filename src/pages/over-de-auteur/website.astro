---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/Plate.astro';
import oldWebsite from '../../assets/littlemousey-old-website.png';
import secondWebsite from '../../assets/website-second-version.png';
---

<BaseLayout
  title="Over deze website"
  description="Atelier de kleine muis is gebouwd met Astro als statische site, op het Classical design system. Eerdere versies draaiden op VitePress en daarvoor op Vue.js, Nuxt en Vuetify."
  narrow
>
  <div class="page-head">
    <p class="kicker">Colofon</p>
    <h1>Over deze website</h1>
  </div>

  <div class="prose">
    <p>
      Deze website is gemaakt met <a href="https://astro.build/" rel="noopener">Astro</a> en wordt
      als volledig statische site gepubliceerd, vormgegeven op het Classical design system. De
      vorige versie was gemaakt met <a href="https://vitepress.dev/" rel="noopener">VitePress</a> {" "}
      en de versie daarvoor met Vue.js, Nuxt en Vuetify.
    </p>
    <p>
      De code repository van de eerste website is {" "}
      <a href="https://github.com/littlemousey/littlemousey" rel="noopener">hier</a> te vinden 💻 Je
      kunt ook de code van de huidige website {" "}
      <a href="https://github.com/littlemousey/atelierdekleinemuis" rel="noopener">hier</a> bekijken.
    </p>

    <Plate
      src={oldWebsite}
      alt="Schermafbeelding van de eerste website, gebouwd met Vue.js, Nuxt en Vuetify"
      widths={[320, 640, 900]}
      sizes="(min-width: 800px) 705px, 92vw"
      class="plate--cover"
      caption="Eerste website"
    />
    <Plate
      src={secondWebsite}
      alt="Schermafbeelding van de tweede website, gebouwd met Vitepress"
      widths={[320, 640, 900]}
      sizes="(min-width: 800px) 705px, 92vw"
      class="plate--cover"
      caption="Tweede versie website"
    />
  </div>
</BaseLayout>
