---
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';
import wave from '../assets/littlemousey_wave.png';
---

<BaseLayout title="Pagina niet gevonden" noindex narrow>
  <div class="page-head">
    <h1>Deze pagina is weggemuisd 🐭</h1>
  </div>

  <div class="prose">
    <p>
      De pagina die je zocht bestaat niet (meer). Misschien vind je in het {" "}
      <a href="/atelier/">atelier</a> wat je zocht, anders kan je het beste terug naar de {" "}
      <a href="/">homepage</a>.
    </p>
    <Plate src={wave} alt="" width={220} />
  </div>
</BaseLayout>
