---
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';
import wave from '../assets/littlemousey_wave.png';
---

<BaseLayout title="Pagina niet gevonden" noindex narrow>
  <div class="page-head">
    <p class="kicker">404</p>
    <h1>Deze pagina is weggemuisd</h1>
  </div>

  <div class="prose">
    <p>
      De pagina die je zocht bestaat niet (meer). Misschien vind je bij de
      <a href="/verhalen/">verhalen</a> wat je zocht, of ga terug naar de
      <a href="/">homepage</a>.
    </p>
    <Plate src={wave} alt="" width={220} />
  </div>
</BaseLayout>
