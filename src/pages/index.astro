---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';
import { GREETINGS } from '../data/greetings';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from '../consts';

const verhalen = (await getCollection('verhalen')).sort((a, b) => a.data.order - b.data.order);
const nieuwste = verhalen[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: Astro.site?.href,
  inLanguage: 'nl-NL',
  author: { '@type': 'Person', name: AUTHOR },
};
---

<BaseLayout jsonLd={jsonLd}>
  <div class="hero">
    <div>
      <p class="kicker">Verhalen · Projecten · Muizen</p>
      <h1>Welkom bij het atelier van de kleine muis</h1>
      <p class="lede">
        Muizen zijn overal. Ze leven in plantgewassen, struiken, maken holletjes onder de grond en
        leven ook in huizen in kleine holletjes en gaatjes. Eigenlijk hebben ze dezelfde
        basisbehoeften als wij: ze verlangen naar eten, drinken, liefde, geborgenheid en een warm
        onderkomen. Hier kun je hun verhalen gratis online lezen.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/verhalen/">Lees de verhalen</a>
        <a class="btn btn-secondary" href="/projecten/">Bekijk de projecten</a>
      </div>

      {nieuwste && (
        <>
          <hr class="hr" />
          <p class="kicker">Nieuwste verhaal</p>
          <p class="index-list__title">
            <a href={`/verhalen/${nieuwste.id}/`}>{nieuwste.data.title}</a>
          </p>
        </>
      )}
    </div>

    <div>
      <ul class="greetings">
        {GREETINGS.map((g) => (
          <li>
            <span class="g-text" lang={g.lang}>{g.text}</span>
            <span class="g-lang">{g.lang}</span>
          </li>
        ))}
      </ul>
      <Plate
        src="/img/littlemousey_wave.png"
        alt="De getekende kleine muis zwaait"
        width="300"
        height="300"
        loading="eager"
        fetchpriority="high"
        caption="De kleine muis zwaait — getekend sinds de basisschool."
      />
    </div>
  </div>
</BaseLayout>
