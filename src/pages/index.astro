---
import BaseLayout from "../layouts/BaseLayout.astro";
import Plate from "../components/Plate.astro";
import wave from "../assets/littlemousey_wave.png";
import { GREETINGS } from "../data/greetings";
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from "../consts";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: Astro.site?.href,
  inLanguage: "nl-NL",
  author: { "@type": "Person", name: AUTHOR },
};
---

<BaseLayout jsonLd={jsonLd}>
  <div class="hero">
    <div>
      <p class="kicker">Verhalen · Projecten · Muizen</p>
      <h1>Welkom bij het atelier van de kleine muis</h1>
      <p class="lede">
        Je hebt mijn kleine muizenhoekje van het internet gevonden 🐁 <br />
        Leuk dat je er bent! Neem gerust een kijkje. <br />
        Misschien ben je geïnteresseerd in mijn verhalen, gedichten of digitale kunst.
        <br />
        Of misschien spreekt een van mijn hobby applicaties je aan 🎮 <br />
        Veel plezier en wie weet tot ziens!
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/verhalen/">Lees de verhalen</a>
        <a class="btn btn-secondary" href="/atelier/">Bezoek het atelier</a>
        <a class="btn btn-secondary" href="/projecten/">Bekijk de projecten</a>
      </div>
      <blockquote>
        Your very own story <br />
        Everyone deserves it <br />
        You, me and yes also mice <br />
      </blockquote>
    </div>

    <div>
      <ul class="greetings">
        {
          GREETINGS.map((g) => (
            <li>
              <span class="g-text" lang={g.lang}>
                {g.text}
              </span>
              <span class="g-lang">{g.lang}</span>
            </li>
          ))
        }
      </ul>
      <Plate
        src={wave}
        alt="De getekende kleine muis zwaait"
        width={300}
        loading="eager"
        fetchpriority="high"
        caption="De kleine muis zwaait — getekend sinds de basisschool."
      />
    </div>
  </div>
</BaseLayout>
