---
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';
import { GREETINGS } from '../data/greetings';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR } from '../consts';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: Astro.site?.href,
  inLanguage: 'nl-NL',
  author: { '@type': 'Person', name: AUTHOR },
};
---

<BaseLayout jsonLd={jsonLd}>
  <div class="hero">
    <div>
      <p class="kicker">Verhalen · Projecten · Muizen</p>
      <h1>Welkom bij het atelier van de kleine muis</h1>
      <p class="lede">
        Muizen zijn overal, van de hoogste toppen van het Andesgebergte tot vlak onder je eigen dak. Ze leven tussen plantgewassen en struiken, maken holletjes onder de grond en wonen in kleine gaatjes in je muren, op je zolder of in je kelderkast. Hier kun je hun verhalen gratis online lezen.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/verhalen/">Lees de verhalen</a>
        <a class="btn btn-secondary" href="/projecten/">Bekijk de projecten</a>
      </div>
    </div>

    <div>
      <ul class="greetings">
        {GREETINGS.map((g) => (
          <li>
            <span class="g-text" lang={g.lang}>{g.text}</span>
            <span class="g-lang">{g.lang}</span>
          </li>
        ))}
      </ul>
      <Plate
        src="/img/littlemousey_wave.png"
        alt="De getekende kleine muis zwaait"
        width="300"
        height="300"
        loading="eager"
        fetchpriority="high"
        caption="De kleine muis zwaait — getekend sinds de basisschool."
      />
    </div>
  </div>
</BaseLayout>
